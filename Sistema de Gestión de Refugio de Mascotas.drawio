<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="Ho3WO8WwBXgCCSbQWtmT">
    <mxGraphModel dx="6185" dy="2820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nnamespace model {\n  class Mascota {\n    -int id\n    -String nombre\n    -String especie\n    -String raza\n    -int edad\n    -String sexo\n    -String estado\n    &lt;&lt;static&gt;&gt; +String DISPONIBLE\n    &lt;&lt;static&gt;&gt; +String EN_PROCESO\n    &lt;&lt;static&gt;&gt; +String ADOPTADA\n    +Mascota(int, String, String, String, int, String, String)\n    +Mascota(int, String, String, String, int, String)\n    +Mascota(String, Integer, int, String)\n    +gettersSetters() void\n    +toString() String\n  }\n\n  class Persona {\n    -int id\n    -String nombre\n    -int edad\n    -String residencia\n    -String telefono\n    -int estrato\n    +Persona(int, String, int, String, String, int)\n    +Persona(String, Integer, int, int, String)\n    +gettersSetters() void\n    +getEstrato_economico() int\n    +setEstrato_economico(int) void\n    +toString() String\n  }\n\n  class Adoptante {\n    -String fechaRegistro\n    +Adoptante(int, String, int, String, String, int, String)\n    +Adoptante(String, Integer, int, int, String)\n    +getFechaRegistro() String\n    +setFechaRegistro(String) void\n    +toString() String\n  }\n\n  class Encargado {\n    -String cargo\n    +Encargado(int, String, int, String, String, int, String)\n    +getCargo() String\n    +setCargo(String) void\n    +toString() String\n  }\n\n  class Adopcion {\n    -int id\n    -int mascotaId\n    -int adoptanteId\n    -int encargadoId\n    -String fecha\n    -String estado\n    &lt;&lt;static&gt;&gt; +String SOLICITADA\n    &lt;&lt;static&gt;&gt; +String APROBADA\n    &lt;&lt;static&gt;&gt; +String RECHAZADA\n    &lt;&lt;static&gt;&gt; +String FINALIZADA\n    +Adopcion(int, int, int, int, String, String)\n    +gettersSetters() void\n    +toString() String\n  }\n\n  class ControlVeterinario {\n    -int id\n    -int mascotaId\n    -String fecha\n    -String tipo\n    -String descripcion\n    -String veterinario\n    +ControlVeterinario(int, int, String, String, String, String)\n    +gettersSetters() void\n    +toString() String\n  }\n\n  Persona &lt;|-- Adoptante\n  Persona &lt;|-- Encargado\n}\n\nnamespace repository {\n  class MascotaRepository {\n    -ArrayList~Mascota~ mascotas\n    +MascotaRepository()\n    +guardar(Mascota) boolean\n    +listar() ArrayList~Mascota~\n    +buscarPorId(int) Mascota\n    +contar() int\n  }\n\n  class AdoptanteRepository {\n    -ArrayList~Adoptante~ adoptantes\n    +AdoptanteRepository()\n    +guardar(Adoptante) boolean\n    +listar() ArrayList~Adoptante~\n    +buscarPorId(int) Adoptante\n    +contar() int\n  }\n\n  class EncargadoRepository {\n    -ArrayList~Encargado~ encargados\n    +EncargadoRepository()\n    +guardar(Encargado) boolean\n    +listar() ArrayList~Encargado~\n    +buscarPorId(int) Encargado\n    +contar() int\n  }\n\n  class AdopcionRepository {\n    -ArrayList~Adopcion~ adopciones\n    +AdopcionRepository()\n    +guardar(Adopcion) boolean\n    +listar() ArrayList~Adopcion~\n    +buscarPorId(int) Adopcion\n    +contar() int\n  }\n\n  class ControlVeterinarioRepository {\n    -ArrayList~ControlVeterinario~ controles\n    +ControlVeterinarioRepository()\n    +guardar(ControlVeterinario) boolean\n    +listar() ArrayList~ControlVeterinario~\n    +buscarPorId(int) ControlVeterinario\n    +contar() int\n    +listarPorMascota(int) ArrayList~ControlVeterinario~\n  }\n\n  MascotaRepository o-- \&quot;0..*\&quot; Mascota\n  AdoptanteRepository o-- \&quot;0..*\&quot; Adoptante\n  EncargadoRepository o-- \&quot;0..*\&quot; Encargado\n  AdopcionRepository o-- \&quot;0..*\&quot; Adopcion\n  ControlVeterinarioRepository o-- \&quot;0..*\&quot; ControlVeterinario\n}\n\nnamespace service {\n  class MascotaService {\n    -MascotaRepository repository\n    +MascotaService(MascotaRepository)\n    +registrarMascota(int, String, String, String, int, String) String\n    +listarMascotas() ArrayList~Mascota~\n    +buscarMascota(int) Mascota\n    +actualizarEstado(int, String) boolean\n  }\n\n  class AdoptanteService {\n    -AdoptanteRepository repository\n    +AdoptanteService(AdoptanteRepository)\n    +registrarAdoptante(int, String, int, String, String, int, String) String\n    +listarAdoptantes() ArrayList~Adoptante~\n    +buscarAdoptante(int) Adoptante\n  }\n\n  class EncargadoService {\n    -EncargadoRepository repository\n    +EncargadoService(EncargadoRepository)\n    +registrarEncargado(int, String, int, String, String, int, String) String\n    +listarEncargados() ArrayList~Encargado~\n    +buscarEncargado(int) Encargado\n  }\n\n  class AdopcionService {\n    -AdopcionRepository adopcionRepository\n    -MascotaRepository mascotaRepository\n    -AdoptanteRepository adoptanteRepository\n    -EncargadoRepository encargadoRepository\n    +AdopcionService(AdopcionRepository, MascotaRepository, AdoptanteRepository, EncargadoRepository)\n    +crearSolicitud(int, int, int, int, String) String\n    +cambiarEstado(int, String) String\n    +listarAdopciones() ArrayList~Adopcion~\n    +buscarAdopcion(int) Adopcion\n  }\n\n  class ControlVeterinarioService {\n    -ControlVeterinarioRepository controlRepository\n    -MascotaRepository mascotaRepository\n    +ControlVeterinarioService(ControlVeterinarioRepository, MascotaRepository)\n    +registrarControl(int, int, String, String, String, String) String\n    +historialPorMascota(int) ArrayList~ControlVeterinario~\n    +listarControles() ArrayList~ControlVeterinario~\n  }\n\n  MascotaService ..&gt; MascotaRepository\n  AdoptanteService ..&gt; AdoptanteRepository\n  EncargadoService ..&gt; EncargadoRepository\n  AdopcionService ..&gt; AdopcionRepository\n  AdopcionService ..&gt; MascotaRepository\n  AdopcionService ..&gt; AdoptanteRepository\n  AdopcionService ..&gt; EncargadoRepository\n  ControlVeterinarioService ..&gt; ControlVeterinarioRepository\n  ControlVeterinarioService ..&gt; MascotaRepository\n}\n\nnamespace main {\n  class Main {\n    -Scanner sc\n    -MascotaService mascotaService\n    -AdoptanteService adoptanteService\n    -EncargadoService encargadoService\n    -AdopcionService adopcionService\n    -ControlVeterinarioService controlService\n    +Main()\n    -cargarDatosEjemplo() void\n    -menu() void\n    -registrarMascota() void\n    -registrarAdoptante() void\n    -registrarEncargado() void\n    -gestionarAdopcion() void\n    -registrarControl() void\n    -consultarHistorial() void\n    -listarTodo() void\n    -leerNumero(String) int\n    +main(String[]) static void\n  }\n\n  Main ..&gt; MascotaService\n  Main ..&gt; AdoptanteService\n  Main ..&gt; EncargadoService\n  Main ..&gt; AdopcionService\n  Main ..&gt; ControlVeterinarioService\n  Main ..&gt; Scanner\n}\n\nnote for Mascota \&quot;Regla de estados: DISPONIBLE -&gt; EN_PROCESO al crear una solicitud. APROBADA o FINALIZADA -&gt; ADOPTADA. RECHAZADA -&gt; DISPONIBLE.\&quot;\nnote for Adopcion \&quot;Los vínculos con Mascota, Adoptante y Encargado se almacenan únicamente mediante mascotaId, adoptanteId y encargadoId.\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RXeh0EqKOG_E7WC-TJ5g-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
